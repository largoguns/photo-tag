# Copy to .env (local) or set these in Portainer → Stack → Environment variables.
# Never commit real values.

# --- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=fotos.midominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://fotos.midominio.com
TZ=Europe/Madrid

# --- Database (DATABASE_URL is built from this in docker-compose.yml) -------
POSTGRES_PASSWORD=

# --- Users ------------------------------------------------------------------
SUPERADMIN_USERNAME=admin
# Required on first start only; ignored once a superadmin exists.
SUPERADMIN_PASSWORD=
# Generic initial password for new users (they must change it on first login).
DEFAULT_USER_PASSWORD=

# --- Cloudflare tunnel ------------------------------------------------------
TUNNEL_TOKEN=

# --- Worker -----------------------------------------------------------------
POLL_INTERVAL_SECONDS=60
MIN_PHOTO_AREA_RATIO=0.03
FACE_SCORE_THRESHOLD=0.7
# Identity suggestions: minimum SFace cosine similarity (web) and recompute interval (worker).
FACE_MATCH_THRESHOLD=0.363
EMBEDDING_POLL_SECONDS=60
# Automatic export every N hours (0 = only from the administration button).
EXPORT_INTERVAL_HOURS=0

# --- Push notifications -----------------------------------------------------
# Generate once: docker compose run --rm web python manage.py generate_vapid_keys
# Leave empty to disable notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com
NOTIFY_POLL_MINUTES=10
NOTIFY_MIN_INTERVAL_MINUTES=60
NOTIFY_QUIET_HOURS=22-9

# --- Host paths (NAS) -------------------------------------------------------
# OpenMediaVault shared folders live under /srv/dev-disk-by-uuid-<disk>/.
HOST_SCANS_DIR=/srv/dev-disk-by-uuid-XXXX/phototag/scans
HOST_PHOTOS_DIR=/srv/dev-disk-by-uuid-XXXX/phototag/photos
HOST_EXPORT_DIR=/srv/dev-disk-by-uuid-XXXX/phototag/export
HOST_BACKUPS_DIR=/srv/dev-disk-by-uuid-XXXX/phototag/backups

# --- Container user ---------------------------------------------------------
# Owner of the folders above: run `id <your-user>` on the NAS (OMV group "users" = 100).
PUID=1000
PGID=100
