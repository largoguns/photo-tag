# Copy to .env (local) or set these in Portainer → Stack → Environment variables.
# Never commit real values.

# --- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=
# Tailscale Funnel hostname: <TS_HOSTNAME>.<your-tailnet>.ts.net
DJANGO_ALLOWED_HOSTS=phototag.tu-tailnet.ts.net
DJANGO_CSRF_TRUSTED_ORIGINS=https://phototag.tu-tailnet.ts.net
TZ=Europe/Madrid

# --- Database (DATABASE_URL is built from this in docker-compose.yml) -------
POSTGRES_PASSWORD=

# --- Users ------------------------------------------------------------------
SUPERADMIN_USERNAME=admin
# Required on first start only; ignored once a superadmin exists.
SUPERADMIN_PASSWORD=
# Generic initial password for new users (they must change it on first login).
DEFAULT_USER_PASSWORD=

# --- Tailscale Funnel -------------------------------------------------------
# Auth key (Tailscale admin → Settings → Keys); only used on the first start.
TS_AUTHKEY=
TS_HOSTNAME=phototag

# --- Worker -----------------------------------------------------------------
POLL_INTERVAL_SECONDS=60
MIN_PHOTO_AREA_RATIO=0.03
FACE_SCORE_THRESHOLD=0.7
# Identity suggestions: minimum SFace cosine similarity (web) and recompute interval (worker).
FACE_MATCH_THRESHOLD=0.363
EMBEDDING_POLL_SECONDS=60
# Automatic export every N hours (0 = only from the administration button).
EXPORT_INTERVAL_HOURS=0

# --- Uploads from the web (written to HOST_SCANS_DIR/inbox) -------------------
UPLOAD_MAX_MB=50

# --- Network scanner (eSCL/AirScan, e.g. HP DeskJet 2700) -------------------
# Give the printer a fixed IP in the router. Empty disables "Scan" in the app.
SCANNER_URL=

# --- Push notifications -----------------------------------------------------
# Generate once: docker compose run --rm web python manage.py generate_vapid_keys
# Leave empty to disable notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com
NOTIFY_POLL_MINUTES=10
NOTIFY_MIN_INTERVAL_MINUTES=60
NOTIFY_QUIET_HOURS=22-9
NOTIFY_CHALLENGE_DAYS=3

# --- Host paths (NAS) -------------------------------------------------------
# OpenMediaVault: a mergerfs pool (/srv/mergerfs/<pool>/) or a disk (/srv/dev-disk-by-uuid-<disk>/).
HOST_SCANS_DIR=/srv/mergerfs/storage/phototag/scans
HOST_PHOTOS_DIR=/srv/mergerfs/storage/phototag/photos
HOST_EXPORT_DIR=/srv/mergerfs/storage/phototag/export
HOST_BACKUPS_DIR=/srv/mergerfs/storage/phototag/backups

# --- Container user ---------------------------------------------------------
# Owner of the folders above: run `id <your-user>` on the NAS (OMV group "users" = 100).
PUID=1000
PGID=100
